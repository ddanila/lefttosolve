/-!
Rule 643 from https://oeis.org/A283508/internal (retrieved 2026-11-27).
The integer code is indexed from its least significant bit by center + 2*neighbors.
The infinite background is updated too; it is not held OFF.
-/
namespace A283508

abbrev Grid := ℤ → ℤ → Bool

def bit (b : Bool) : ℕ := if b then 1 else 0

def rule (c : Bool) (k : ℕ) : Bool :=
  decide ((643 / 2 ^ (bit c + 2 * k)) % 2 = 1)

theorem rule_readable (c : Bool) (k : ℕ) (hk : k ≤ 4) :
    rule c k = decide (k = 0 ∨ (c = true ∧ 3 ≤ k)) := by
  cases c <;> interval_cases k <;> decide

def neighbors (g : Grid) (x y : ℤ) : ℕ :=
  bit (g (x+1) y) + bit (g (x-1) y) + bit (g x (y+1)) + bit (g x (y-1))

def step (g : Grid) : Grid := fun x y => rule (g x y) (neighbors g x y)

def initial : Grid := fun x y => decide (x = 0 ∧ y = 0)

def evolve (g : Grid) : ℕ → Grid
  | 0 => g
  | n+1 => step (evolve g n)

def state (n : ℕ) : Grid := evolve initial n

def first : Grid := fun x y => decide
  (¬ ((x = 0 ∧ (y = -1 ∨ y = 1)) ∨ (y = 0 ∧ (x = -1 ∨ x = 1))))

def stable : Grid := fun x y => decide
  (x < -1 ∨ 1 < x ∨ y < -1 ∨ 1 < y ∨ (x = 0 ∧ y = 0))

/-- Decimal encoding of positions 0 through m, most significant digit first. -/
def encode (g : Grid) : ℕ → ℕ
  | 0 => bit (g 0 0)
  | m+1 => 10 * encode g m + bit (g (↑(m+1 : ℕ)) 0)

def a (n : ℕ) : ℕ := encode (state n) n

end A283508


namespace A283508

def Far (r x y : ℤ) : Prop := x < -r ∨ r < x ∨ y < -r ∨ r < y

theorem initial_far {x y : ℤ} (h : Far 1 x y) : initial x y = false := by
  have h' : ¬ (x = 0 ∧ y = 0) := by unfold Far at h; omega
  simp [initial, h']

theorem first_far {x y : ℤ} (h : Far 1 x y) : first x y = true := by
  have h' : ¬ ((x = 0 ∧ (y = -1 ∨ y = 1)) ∨
      (y = 0 ∧ (x = -1 ∨ x = 1))) := by unfold Far at h; omega
  simp [first, h']

theorem stable_far {x y : ℤ} (h : Far 1 x y) : stable x y = true := by
  have h' : x < -1 ∨ 1 < x ∨ y < -1 ∨ 1 < y ∨ (x = 0 ∧ y = 0) := by
    unfold Far at h; omega
  simp [stable, h']

theorem step_far (g : Grid) (b : Bool)
    (hg : ∀ x y, Far 1 x y → g x y = b)
    {x y : ℤ} (h : Far 2 x y) : step g x y = rule b (4 * bit b) := by
  have h0 := hg x y (by unfold Far at *; omega)
  have h1 := hg (x+1) y (by unfold Far at *; omega)
  have h2 := hg (x-1) y (by unfold Far at *; omega)
  have h3 := hg x (y+1) (by unfold Far at *; omega)
  have h4 := hg x (y-1) (by unfold Far at *; omega)
  simp only [step, neighbors, h0, h1, h2, h3, h4]
  congr 1
  omega

theorem step_initial : step initial = first := by
  funext x y
  by_cases h : Far 2 x y
  · rw [step_far initial false (fun _ _ h => initial_far h) h,
        first_far (by unfold Far at *; omega)]
    decide
  · have hx : -2 ≤ x ∧ x ≤ 2 := by unfold Far at h; omega
    have hy : -2 ≤ y ∧ y ≤ 2 := by unfold Far at h; omega
    rcases hx with ⟨hx0, hx1⟩
    rcases hy with ⟨hy0, hy1⟩
    interval_cases x <;> interval_cases y <;> decide

theorem step_first : step first = stable := by
  funext x y
  by_cases h : Far 2 x y
  · rw [step_far first true (fun _ _ h => first_far h) h,
        stable_far (by unfold Far at *; omega)]
    decide
  · have hx : -2 ≤ x ∧ x ≤ 2 := by unfold Far at h; omega
    have hy : -2 ≤ y ∧ y ≤ 2 := by unfold Far at h; omega
    rcases hx with ⟨hx0, hx1⟩
    rcases hy with ⟨hy0, hy1⟩
    interval_cases x <;> interval_cases y <;> decide

theorem step_stable : step stable = stable := by
  funext x y
  by_cases h : Far 2 x y
  · rw [step_far stable true (fun _ _ h => stable_far h) h,
        stable_far (by unfold Far at *; omega)]
    decide
  · have hx : -2 ≤ x ∧ x ≤ 2 := by unfold Far at h; omega
    have hy : -2 ≤ y ∧ y ≤ 2 := by unfold Far at h; omega
    rcases hx with ⟨hx0, hx1⟩
    rcases hy with ⟨hy0, hy1⟩
    interval_cases x <;> interval_cases y <;> decide

theorem state_one : state 1 = first := step_initial

theorem state_add_two (n : ℕ) : state (n+2) = stable := by
  induction n with
  | zero => exact congrArg step step_initial |>.trans step_first
  | succ n ih =>
    change step (state (n+2)) = stable
    rw [ih, step_stable]

theorem state_stable (n : ℕ) (hn : 2 ≤ n) : state n = stable := by
  obtain ⟨k, rfl⟩ : ∃ k, n = k+2 := ⟨n-2, by omega⟩
  exact state_add_two k

theorem stable_axis (m : ℕ) : stable m 0 = decide (m ≠ 1) := by
  by_cases h : m = 1
  · subst m; decide
  · simp [stable, h]
    omega

theorem axis_pattern (n m : ℕ) (hn : 0 < n) (hm : m ≤ n) :
    state n m 0 = decide (m ≠ 1) := by
  by_cases h : n = 1
  · subst n
    rw [state_one]
    interval_cases m <;> decide
  · rw [state_stable n (by omega), stable_axis]

theorem encode_stable_one : encode stable 1 = 10 := by decide

theorem encode_stable_succ (n : ℕ) (hn : 1 ≤ n) :
    encode stable (n+1) = 10 * encode stable n + 1 := by
  rw [encode, stable_axis]
  simp [bit, show n ≠ 0 by omega]

theorem encode_stable_identity (n : ℕ) (hn : 0 < n) :
    90 * encode stable n + 10 = 91 * 10^n := by
  obtain ⟨k, rfl⟩ : ∃ k, n = k+1 := ⟨n-1, by omega⟩
  induction k with
  | zero => decide
  | succ k ih =>
    rw [encode_stable_succ (k+1) (by omega), pow_succ]
    calc
      90 * (10 * encode stable (k+1) + 1) + 10 =
          10 * (90 * encode stable (k+1) + 10) := by ring
      _ = _ := by rw [ih (by omega)]; ring

theorem a_eq_encode_stable (n : ℕ) (hn : 0 < n) : a n = encode stable n := by
  by_cases h : n = 1
  · subst n; decide
  · unfold a; rw [state_stable n (by omega)]

/-- The closed-form conjecture in OEIS A283508, with the source's n > 0 range. -/
theorem formula (n : ℕ) (hn : 0 < n) : a n = (91 * 10^n - 10) / 90 := by
  rw [a_eq_encode_stable n hn]
  have h := encode_stable_identity n hn
  have heq : 91 * 10^n - 10 = 90 * encode stable n := by omega
  rw [heq, Nat.mul_div_right]; decide

/-- Exact identity: the division in formula loses no fractional remainder. -/
theorem exact_identity (n : ℕ) (hn : 0 < n) : 90 * a n + 10 = 91 * 10^n := by
  rw [a_eq_encode_stable n hn]
  exact encode_stable_identity n hn

theorem a_succ (n : ℕ) (hn : 0 < n) : a (n+1) = 10 * a n + 1 := by
  rw [a_eq_encode_stable (n+1) (by omega), a_eq_encode_stable n hn,
      encode_stable_succ n (by omega)]

/-- The recurrence stated in OEIS, with natural subtraction justified by the proof. -/
theorem recurrence (n : ℕ) (hn : 2 < n) :
    a n = 11 * a (n-1) - 10 * a (n-2) := by
  have h1 := a_succ (n-1) (by omega)
  have h2 := a_succ (n-2) (by omega)
  have e1 : n-1+1 = n := by omega
  have e2 : n-2+1 = n-1 := by omega
  rw [e1] at h1
  rw [e2] at h2
  omega

end A283508


namespace A283508

theorem a_zero : a 0 = 1 := by decide
theorem a_one : a 1 = 10 := by decide
theorem a_two : a 2 = 101 := by decide

theorem recurrence_int (n : ℕ) (hn : 2 < n) :
    (a n : ℤ) = 11 * (a (n-1) : ℤ) - 10 * (a (n-2) : ℤ) := by
  have h1 := a_succ (n-1) (by omega)
  have h2 := a_succ (n-2) (by omega)
  have e1 : n-1+1 = n := by omega
  have e2 : n-2+1 = n-1 := by omega
  rw [e1] at h1
  rw [e2] at h2
  have c1 := congrArg (fun k : ℕ => (k : ℤ)) h1
  have c2 := congrArg (fun k : ℕ => (k : ℤ)) h2
  push_cast at c1 c2
  omega

def series : PowerSeries ℤ := PowerSeries.mk (fun n => (a n : ℤ))

theorem generating_function :
    series * ((1 - PowerSeries.X) * (1 - 10 * PowerSeries.X)) =
      1 - PowerSeries.X + PowerSeries.X^2 := by
  have expand : series * ((1 - PowerSeries.X) * (1 - 10 * PowerSeries.X)) =
      series - PowerSeries.C 11 * (series * PowerSeries.X^1) +
        PowerSeries.C 10 * (series * PowerSeries.X^2) := by
    simp only [map_ofNat, pow_one]
    ring
  rw [expand]
  ext n
  simp only [map_add, map_sub, PowerSeries.coeff_C_mul,
    PowerSeries.coeff_mul_X_pow', series, PowerSeries.coeff_mk]
  rcases n with _ | _ | _ | n
  · simp [a_zero]
  · simp [a_one, a_zero]
  · simp [a_two, a_one, a_zero, PowerSeries.coeff_X]
  · have h := recurrence_int (n+3) (by omega)
    simp only [show 1 ≤ n+3 by omega, show 2 ≤ n+3 by omega, if_true,
      PowerSeries.coeff_one, PowerSeries.coeff_X, PowerSeries.coeff_X_pow]
    simp
    simpa using (show (a (n+3) : ℤ) - 11*(a (n+2) : ℤ) + 10*(a (n+1) : ℤ) = 0 by
      simp only [show n+3-1=n+2 by omega, show n+3-2=n+1 by omega] at h
      omega)

end A283508


/-! Standard Wolfram Rule 187 from OEIS A267623.
The left cell has weight 4, the centre weight 2, and the right cell weight 1.
The entry’s Maple program mirrors this orientation; the centre sequence is unchanged.
The sequence reads the centre cell through TIME, encoding the bits in decimal.
-/
namespace A267623

abbrev Row := ℤ → Bool
def bit (b : Bool) : ℕ := if b then 1 else 0
def rule (l c r : Bool) : Bool :=
  decide ((187 / 2 ^ (4 * bit l + 2 * bit c + bit r)) % 2 = 1)
def step (g : Row) : Row := fun x => rule (g (x-1)) (g x) (g (x+1))
def initial : Row := fun x => decide (x = 0)
def state : ℕ → Row
  | 0 => initial
  | n+1 => step (state n)
def a : ℕ → ℕ
  | 0 => bit (state 0 0)
  | n+1 => 10 * a n + bit (state (n+1) 0)

theorem rule_readable (l c r : Bool) : rule l c r = (!c || r) := by
  cases l <;> cases c <;> cases r <;> decide

def hole (k : ℤ) : Row := fun x => decide (x ≠ k)

theorem step_initial : step initial = hole 0 := by
  funext x
  simp [step, rule_readable, initial, hole]
  omega

theorem step_hole (k : ℤ) : step (hole k) = hole (k-1) := by
  funext x
  by_cases h : x = k-1
  · simp [step, rule_readable, hole, h]
  · have h1 : x+1 ≠ k := by omega
    simp [step, rule_readable, hole, h1, h]

theorem state_succ (n : ℕ) : state (n+1) = hole (-(n : ℤ)) := by
  induction n with
  | zero => exact step_initial
  | succ n ih =>
    change step (state (n+1)) = hole (-↑(n+1 : ℕ))
    rw [ih, step_hole]
    congr 1
    push_cast
    ring

theorem center (n : ℕ) : state n 0 = decide (n ≠ 1) := by
  cases n with
  | zero => decide
  | succ n => rw [state_succ]; simp [hole, eq_comm]

theorem sequence_eq (n : ℕ) : A283508.a n = a n := by
  induction n with
  | zero => rfl
  | succ n ih =>
    cases n with
    | zero => decide
    | succ n =>
      rw [A283508.a_succ (n+1) (by omega), a, center, ← ih]
      simp [bit]

end A267623

