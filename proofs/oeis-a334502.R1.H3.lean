/-- Boolean local rule, independent of the bit-vector representation. -/
def localRule (l c r : Bool) : Bool := (!l && (c || r)) || (l && !c)

def prev (n i : ℕ) : ℕ := if i = 0 then n-1 else i-1
def next (n i : ℕ) : ℕ := if i+1 = n then 0 else i+1

