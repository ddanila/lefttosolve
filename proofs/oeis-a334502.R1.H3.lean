lemma pair_of_model (n T : ℕ) (_hn : 2<n) (C : ℕ → ℕ → Prop)
    (bridge : ∀ t i, i<n → ((row n t).getLsbD i=true ↔ C t i))
    (cycle : ∀ i, i<n → (C (T+3) i ↔ C T i))
    (different : ¬ (C (T+1) 2 ↔ C T 2)) : row n (T+3)=row n T ∧ row n (T+1)≠row n T := by
  constructor
  · apply BitVec.eq_of_getLsbD_eq
    intro i hi
    apply Bool.eq_iff_iff.mpr
    exact (bridge (T+3) i hi).trans ((cycle i hi).trans (bridge T i hi).symm)
  · intro he
    apply different
    rw [← bridge (T+1) 2 _hn, ← bridge T 2 _hn, he]

end A334502Local

