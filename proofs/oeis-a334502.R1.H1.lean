/-- The pruned residue model supplies a uniform certificate at time 12*n. -/
theorem result : OMA.R_oeis_a334502_R1.H1 := by
  intro n _hn _hg
  let C : ℕ → ℕ → Prop := fun t i => Compact.cell n t i
  have initial : ∀ i, i<n → (C 0 i ↔ i=0) := by
    intro i hi
    simpa only [C, Nat.cast_zero, Nat.cast_eq_zero] using
      Compact.initial n i (by omega) (by omega) (by omega) (by omega)
  have bridge := row_model n (by omega) C initial (fun t i hi => cell_step_nat n t i _hn _hg hi)
  refine ⟨12*n, pair_of_model n (12*n) (by omega) C bridge ?_ ?_⟩
  · intro i hi
    simpa only [C, Nat.cast_add, Nat.cast_mul, Nat.cast_ofNat, Nat.cast_one] using
      Compact.period n i (by omega) (by omega) (by omega) (by omega)
  · simpa only [C, Nat.cast_add, Nat.cast_mul, Nat.cast_ofNat, Nat.cast_one] using
      Compact.nonfixed n (by omega) (by omega)
