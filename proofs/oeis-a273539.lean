private theorem certificate_terminal (k : Fin 451) : (cert k).holds 0 0 0 := by
  have h := List.all_eq_true.mp terminalChecked k.val (List.mem_range.mpr k.isLt)
  simp only [terminalCheck, Nat.mod_eq_of_lt k.isLt] at h
  unfold Certificate.holds
  split <;> simp_all

private def closedCheck (k b : ℕ) : Bool :=
  let k' : Fin 451 := ⟨k%451, by omega⟩
