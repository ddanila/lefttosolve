private theorem certificate_closed (k : Fin 451) (b : Fin 8) :
    (cert k).advance (b.val/4) ((b.val/2)%2) (b.val%2) = cert (certNext k b) := by
  have h := List.all_eq_true.mp closedChecked k.val (List.mem_range.mpr k.isLt)
  have hb := List.all_eq_true.mp h b.val (List.mem_range.mpr b.isLt)
  simpa only [closedCheck, Nat.mod_eq_of_lt k.isLt, Nat.mod_eq_of_lt b.isLt,
    decide_eq_true_eq] using hb

