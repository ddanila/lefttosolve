/-! ## Parity, alternative rules, and algebraic consequences -/

namespace A273539Consequences
open OMA.S_oeis_a273539

/-- Evolution of the spatially uniform background. -/
private def background (r : ℕ) : ℕ → Bool
  | 0 => false
  | t+1 => rule r (background r t) (4 * bit (background r t))

/-- A cell outside the time-t square cannot yet see the initial ON origin. -/
private lemma outside (r t : ℕ) (x y : ℤ)
    (h : x < -(t : ℤ) ∨ (t : ℤ) < x ∨ y < -(t : ℤ) ∨ (t : ℤ) < y) :
    state r t x y = background r t := by
  induction t generalizing x y with
  | zero =>
    have h0 : ¬(x = 0 ∧ y = 0) := by omega
    simp [state, initial, background, h0]
  | succ t ih =>
    have hc := ih x y (by omega)
    have he := ih (x+1) y (by omega)
    have hw := ih (x-1) y (by omega)
    have hn := ih x (y+1) (by omega)
    have hs := ih x (y-1) (by omega)
    simp only [state, step, neighbors, hc, he, hw, hn, hs, background]
    congr 1
    omega

/-- The four rules agree on ON centres and on cells with four ON neighbours. -/
private lemma rule_agrees (r : ℕ) (hr : r ∈ ([779,795,843,859] : List ℕ))
    (c : Bool) (k : ℕ) (hk : k ≤ 4) (h : c = true ∨ k = 4) :
    rule r c k = rule 779 c k := by
  cases c with
  | false =>
    have hk4 : k = 4 := h.resolve_left (by decide)
    subst k
    simp only [List.mem_cons, List.not_mem_nil, or_false] at hr
    rcases hr with rfl | rfl | rfl | rfl <;> decide
  | true =>
    simp only [List.mem_cons, List.not_mem_nil, or_false] at hr
    rcases hr with rfl | rfl | rfl | rfl <;> interval_cases k <;> decide

/-- With four ON neighbours every rule switches its centre ON. -/
private lemma rule_full (r : ℕ) (hr : r ∈ ([779,795,843,859] : List ℕ)) (c : Bool) :
    rule r c 4 = true := by
  simp only [List.mem_cons, List.not_mem_nil, or_false] at hr
  rcases hr with rfl | rfl | rfl | rfl <;> cases c <;> decide

/-- At positive time, all OFF cells lie on a single checkerboard parity. -/
theorem parity_on (r : ℕ) (hr : r ∈ ([779,795,843,859] : List ℕ))
    (t : ℕ) (ht : 1 ≤ t) (x y : ℤ) (h : (x+y-(t : ℤ)) % 2 = 1) :
    state r t x y = true := by
  obtain ⟨k, rfl⟩ : ∃ k, t = k+1 := ⟨t-1, by omega⟩
  clear ht
  induction k generalizing x y with
  | zero =>
    have he : ¬(x+1=0 ∧ y=0) := by omega
    have hw : ¬(x-1=0 ∧ y=0) := by omega
    have hn : ¬(x=0 ∧ y+1=0) := by omega
    have hs : ¬(x=0 ∧ y-1=0) := by omega
    simp only [state, step, neighbors, initial, he, hw, hn, hs, decide_false, bit,
      Bool.false_eq_true, ↓reduceIte, add_zero]
    simp only [List.mem_cons, List.not_mem_nil, or_false] at hr
    rcases hr with rfl | rfl | rfl | rfl <;>
      cases decide (x=0 ∧ y=0) <;> decide
  | succ k ih =>
    have he := ih (x+1) y (by omega)
    have hw := ih (x-1) y (by omega)
    have hn := ih x (y+1) (by omega)
    have hs := ih x (y-1) (by omega)
    change rule r (state r (k+1) x y) (neighbors (state r (k+1)) x y) = true
    rw [show neighbors (state r (k+1)) x y = 4 by simp [neighbors, he, hw, hn, hs, bit]]
    exact rule_full r hr _

/-- The first generation is the same for all four codes. -/
private lemma first (r : ℕ) (hr : r ∈ ([779,795,843,859] : List ℕ)) :
    state r 1 = state 779 1 := by
  funext x y
  by_cases h : x < -1 ∨ 1 < x ∨ y < -1 ∨ 1 < y
  · rw [outside r 1 x y (by simpa using h), outside 779 1 x y (by simpa using h)]
    simp only [List.mem_cons, List.not_mem_nil, or_false] at hr
    rcases hr with rfl | rfl | rfl | rfl <;> decide
  · have hxl : -1 ≤ x := by omega
    have hxu : x ≤ 1 := by omega
    have hyl : -1 ≤ y := by omega
    have hyu : y ≤ 1 := by omega
    simp only [List.mem_cons, List.not_mem_nil, or_false] at hr
    rcases hr with rfl | rfl | rfl | rfl <;>
      interval_cases x <;> interval_cases y <;> decide

/-- The conjectured alternative rules in fact agree at every time and every site. -/
theorem states_agree (r : ℕ) (hr : r ∈ ([779,795,843,859] : List ℕ))
    (t : ℕ) : state r t = state 779 t := by
  cases t with
  | zero => rfl
  | succ t =>
    induction t with
    | zero => exact first r hr
    | succ t ih =>
      funext x y
      change rule r (state r (t+1) x y) (neighbors (state r (t+1)) x y) =
        rule 779 (state 779 (t+1) x y) (neighbors (state 779 (t+1)) x y)
      rw [ih]
      apply rule_agrees r hr
      · unfold neighbors bit
        split <;> split <;> split <;> split <;> omega
      · by_cases h : (x+y-((t+1 : ℕ) : ℤ)) % 2 = 1
        · exact Or.inl (parity_on 779 (by simp) (t+1) (by omega) x y h)
        · right
          have he := parity_on 779 (by simp) (t+1) (by omega) (x+1) y (by omega)
          have hw := parity_on 779 (by simp) (t+1) (by omega) (x-1) y (by omega)
          have hn := parity_on 779 (by simp) (t+1) (by omega) x (y+1) (by omega)
          have hs := parity_on 779 (by simp) (t+1) (by omega) x (y-1) (by omega)
          simp [neighbors, he, hw, hn, hs, bit]

/-- All three named alternatives give the same sampled sequence. -/
theorem alternative_rules (r : ℕ) (hr : r ∈ ([795,843,859] : List ℕ))
    (n : ℕ) : count r (2^n-1) = a n := by
  simp only [a, count, states_agree r (List.mem_cons_of_mem 779 hr)]

/-! ## Reduction to the sampled OFF-cell count -/

/-- OFF cells in the same square crop as the source's ON count. -/
def offCount (t : ℕ) : ℕ :=
  ∑ x ∈ Finset.range (2*t+1), ∑ y ∈ Finset.range (2*t+1),
    bit (!(state 779 t ((x : ℤ)-t) ((y : ℤ)-t)))

/-- Every cell contributes exactly once to the ON or OFF count. -/
theorem count_partition (t : ℕ) : count 779 t + offCount t = (2*t+1)^2 := by
  simp only [count, offCount, ← Finset.sum_add_distrib]
  have hb (b : Bool) : bit b + bit (!b) = 1 := by cases b <;> rfl
  simp [hb, pow_two]

/-- The remaining unproved combinatorial claim, with its time-zero exception. -/
def SampledOffCount : Prop :=
  ∀ n : ℕ, 0 < n → offCount (2^n-1) = 4*(2^n-1)

/-- Once the OFF-cell count is known, the source's closed formula follows. -/
theorem formula_of_off_count (h : SampledOffCount) (n : ℕ) :
    (a n : ℤ) = 5 - 2^(3+n) + 4^(1+n) := by
  cases n with
  | zero =>
    have ha : a 0 = 1 := by decide
    rw [ha]
    norm_num
  | succ n =>
    have hc := count_partition (2^(n+1)-1)
    rw [h (n+1) (by omega)] at hc
    have hc' := congrArg (fun z : ℕ => (z : ℤ)) hc
    have hp : 1 ≤ 2^(n+1) := Nat.one_le_pow _ _ (by omega)
    push_cast [Nat.cast_sub hp] at hc'
    change (a (n+1) : ℤ) + _ = _ at hc'
    have h4 : (4 : ℤ)^(n+1) = (2^(n+1))^2 := by
      rw [← pow_mul, mul_comm (n+1) 2, pow_mul]
      norm_num
    rw [pow_add 2 3 (n+1), pow_add 4 1 (n+1), h4]
    nlinarith

/-- The exponential formula implies the recurrence in exactly the source's range. -/
theorem recurrence_of_formula
    (h : ∀ n : ℕ, (a n : ℤ) = 5 - 2^(3+n) + 4^(1+n))
    (n : ℕ) (hn : 2 < n) :
    (a n : ℤ) = 7*(a (n-1) : ℤ) - 14*(a (n-2) : ℤ) + 8*(a (n-3) : ℤ) := by
  rw [h n, h (n-1), h (n-2), h (n-3)]
  obtain ⟨k,rfl⟩ : ∃ k, n = k+3 := ⟨n-3, by omega⟩
  simp only [show k+3-1=k+2 by omega, show k+3-2=k+1 by omega,
    show k+3-3=k by omega, pow_add]
  ring

/-- Multiplication by a power of X shifts the sequence coefficients. -/
private lemma coeff_series_mul_X (k n : ℕ) :
    PowerSeries.coeff n (series * PowerSeries.X^k) =
      if k ≤ n then (a (n-k) : ℤ) else 0 := by
  simp only [PowerSeries.coeff_mul_X_pow', series, PowerSeries.coeff_mk]

set_option maxHeartbeats 1000000 in
/-- The initial coefficients and the recurrence give the source generating function. -/
theorem generating_function_of_formula
    (h : ∀ n : ℕ, (a n : ℤ) = 5 - 2^(3+n) + 4^(1+n)) :
    series * ((1-PowerSeries.X)*(1-2*PowerSeries.X)*(1-4*PowerSeries.X)) =
      1-2*PowerSeries.X+16*PowerSeries.X^2 := by
  have expand : series * ((1-PowerSeries.X)*(1-2*PowerSeries.X)*(1-4*PowerSeries.X)) =
      series - PowerSeries.C 7 * (series * PowerSeries.X^1) +
        PowerSeries.C 14 * (series * PowerSeries.X^2) -
        PowerSeries.C 8 * (series * PowerSeries.X^3) := by
    simp only [map_ofNat, pow_one]
    ring
  rw [expand]
  have numerator : (1 : PowerSeries ℤ)-2*PowerSeries.X+16*PowerSeries.X^2 =
      1 - PowerSeries.C 2 * PowerSeries.X^1 + PowerSeries.C 16 * PowerSeries.X^2 := by
    simp only [map_ofNat, pow_one]
  rw [numerator]
  ext n
  simp only [map_add, map_sub, PowerSeries.coeff_C_mul, coeff_series_mul_X]
  simp only [series, PowerSeries.coeff_mk]
  rcases n with _ | _ | _ | n
  · simp [h, PowerSeries.coeff_X]
  · simp [h, PowerSeries.coeff_X]
  · simp [h, PowerSeries.coeff_X]
  · have hr := recurrence_of_formula h (n+3) (by omega)
    simp only [show n+3-1=n+2 by omega, show n+3-2=n+1 by omega,
      show n+3-3=n by omega] at hr
    have hz : (a (n+3) : ℤ) - 7*(a (n+2) : ℤ) + 14*(a (n+1) : ℤ) -
        8*(a n : ℤ) = 0 := by omega
    simpa [PowerSeries.coeff_one, PowerSeries.coeff_X, PowerSeries.coeff_X_pow,
      Nat.add_assoc] using hz

/-- Assemble all source conjectures from the sampled OFF-cell count proved below. -/
theorem off_count_suffices (h : SampledOffCount) : type_of% @OMA.S_oeis_a273539.main :=
  ⟨alternative_rules, formula_of_off_count h,
    recurrence_of_formula (formula_of_off_count h),
    generating_function_of_formula (formula_of_off_count h)⟩

end A273539Consequences

/-! ## Integer coordinates and the diamond theorem -/

namespace A273539Bridge
open OMA.S_oeis_a273539
open A273539Automaton (value)

/-- Extend the rotated automaton by OFF cells at negative indices. -/
def rotated (t : ℕ) (i j : ℤ) : Bool :=
  if 0 ≤ i ∧ 0 ≤ j then value 0 t i.toNat j.toNat else false

lemma rotated_neg (t : ℕ) (i j : ℤ) (h : i<0 ∨ j<0) : rotated t i j = false := by
  simp only [rotated, if_neg (by omega : ¬ (0 ≤ i ∧ 0 ≤ j))]

lemma rotated_nat (t i j : ℕ) : rotated t i j = value 0 t i j := by
  simp [rotated]

lemma rotated_zero (i j : ℤ) : rotated 0 i j = decide (i=0 ∧ j=0) := by
  unfold rotated
  split_ifs with h
  · rw [A273539Automaton.initial]
    have he : (i.toNat=0 ∧ j.toNat=0) ↔ (i=0 ∧ j=0) := by omega
    simp only [he]
  · symm
    apply decide_eq_false
    omega

private lemma swap_middle (a b c d : Bool) :
    A273539Automaton.rule a b c d = A273539Automaton.rule a c b d := by
  cases a <;> cases b <;> cases c <;> cases d <;> decide

/-- The four-parent update on the entire integer lattice. -/
lemma rotated_step (t : ℕ) (i j : ℤ) :
    rotated (t+1) i j = A273539Automaton.rule
      (rotated t i j) (rotated t (i-1) j)
      (rotated t i (j-1)) (rotated t (i-1) (j-1)) := by
  by_cases hi : i<0
  · rw [rotated_neg _ _ _ (Or.inl hi), rotated_neg _ _ _ (Or.inl hi),
      rotated_neg _ _ _ (Or.inl (by omega)), rotated_neg _ _ _ (Or.inl hi),
      rotated_neg _ _ _ (Or.inl (by omega))]
    rfl
  by_cases hj : j<0
  · rw [rotated_neg _ _ _ (Or.inr hj), rotated_neg _ _ _ (Or.inr hj),
      rotated_neg _ _ _ (Or.inr hj), rotated_neg _ _ _ (Or.inr (by omega)),
      rotated_neg _ _ _ (Or.inr (by omega))]
    rfl
  lift i to ℕ using (by omega : 0 ≤ i)
  lift j to ℕ using (by omega : 0 ≤ j)
  cases i with
  | zero =>
    cases j with
    | zero =>
      simp only [Nat.cast_zero, zero_sub,
        rotated_neg _ _ _ (Or.inl (by norm_num : (-1:ℤ)<0)),
        rotated_neg _ _ _ (Or.inr (by norm_num : (-1:ℤ)<0))]
      exact A273539Automaton.step_origin t
    | succ j =>
      have hj' : ((j+1:ℕ):ℤ)-1=j := by omega
      rw [hj']
      simp only [Nat.cast_zero, zero_sub,
        rotated_neg _ _ _ (Or.inl (by norm_num : (-1:ℤ)<0))]
      rw [swap_middle]
      exact A273539Automaton.step_left t j
  | succ i =>
    have hi' : ((i+1:ℕ):ℤ)-1=i := by omega
    rw [hi']
    cases j with
    | zero =>
      simp only [Nat.cast_zero, zero_sub,
        rotated_neg _ _ _ (Or.inr (by norm_num : (-1:ℤ)<0))]
      exact A273539Automaton.step_bottom t i
    | succ j =>
      have hj' : ((j+1:ℕ):ℤ)-1=j := by omega
      rw [hj']
      simp only [rotated_nat]
      exact A273539Automaton.step_inner t i j

/-- No rotated cell can propagate beyond one coordinate step per generation. -/
lemma rotated_support (t : ℕ) (i j : ℤ) (h : (t : ℤ) < i ∨ (t : ℤ) < j) :
    rotated t i j = false := by
  induction t generalizing i j with
  | zero =>
    rw [rotated_zero]
    simp only [decide_eq_false_iff_not]
    omega
  | succ t ih =>
    rw [rotated_step, ih i j (by omega), ih (i-1) j (by omega),
      ih i (j-1) (by omega), ih (i-1) (j-1) (by omega)]
    rfl


lemma rotated_one (i j : ℤ) :
    rotated 1 i j = decide ((i=0 ∨ i=1) ∧ (j=0 ∨ j=1)) := by
  rw [rotated_step]
  simp only [rotated_zero, sub_eq_zero]
  by_cases hi0 : i=0 <;> by_cases hi1 : i=1 <;>
    by_cases hj0 : j=0 <;> by_cases hj1 : j=1 <;>
    simp [hi0, hi1, hj0, hj1, A273539Automaton.rule]

lemma state_one (x y : ℤ) :
    state 779 1 x y = decide (¬ ((x=0 ∧ (y=1 ∨ y= -1)) ∨
      (y=0 ∧ (x=1 ∨ x= -1)))) := by
  have he : x+1=0 ↔ x= -1 := by omega
  have hw : x-1=0 ↔ x=1 := by omega
  have hn : y+1=0 ↔ y= -1 := by omega
  have hs : y-1=0 ↔ y=1 := by omega
  simp only [state, step, neighbors, initial, he, hw, hn, hs]
  by_cases hx0 : x=0 <;> by_cases hx1 : x=1 <;> by_cases hxm : x= -1 <;>
    by_cases hy0 : y=0 <;> by_cases hy1 : y=1 <;> by_cases hym : y= -1 <;>
    simp [hx0, hx1, hxm, hy0, hy1, hym, rule, bit]

/-- Rule 779 on an ON centre is the complement of the rotated update on OFF neighbours. -/
private lemma rule_complement (a b c d : Bool) :
    rule 779 true (bit (!a)+bit (!d)+bit (!c)+bit (!b)) =
      !(A273539Automaton.rule a b c d) := by
  cases a <;> cases b <;> cases c <;> cases d <;> decide

/-- The change of coordinates relates the certified machine to the actual source evolution. -/
theorem bridge (t : ℕ) (ht : 1 ≤ t) (i j : ℤ) :
    state 779 t (i+j-t) (i-j) = !(rotated t i j) := by
  obtain ⟨t, rfl⟩ : ∃ k, t=k+1 := ⟨t-1, by omega⟩
  clear ht
  induction t generalizing i j with
  | zero =>
    rw [state_one, rotated_one, ← decide_not]
    congr 1
    apply propext
    omega
  | succ t ih =>
    have hc := A273539Consequences.parity_on 779 (by simp) (t+1) (by omega)
      (i+j-(t+1+1:ℕ)) (i-j) (by omega)
    have he := ih i j
    have hw := ih (i-1) (j-1)
    have hn := ih i (j-1)
    have hs := ih (i-1) j
    change rule 779 (state 779 (t+1) (i+j-(t+1+1:ℕ)) (i-j))
      (neighbors (state 779 (t+1)) (i+j-(t+1+1:ℕ)) (i-j)) = _
    rw [hc]
    unfold neighbors
    have he' : state 779 (t+1) (i+j-(t+1+1:ℕ)+1) (i-j) = !(rotated (t+1) i j) := by
      convert he using 1; congr 1; omega
    have hw' : state 779 (t+1) (i+j-(t+1+1:ℕ)-1) (i-j) = !(rotated (t+1) (i-1) (j-1)) := by
      convert hw using 1; congr 1 <;> omega
    have hn' : state 779 (t+1) (i+j-(t+1+1:ℕ)) (i-j+1) = !(rotated (t+1) i (j-1)) := by
      convert hn using 1; congr 1 <;> omega
    have hs' : state 779 (t+1) (i+j-(t+1+1:ℕ)) (i-j-1) = !(rotated (t+1) (i-1) j) := by
      convert hs using 1; congr 1 <;> omega
    rw [he', hw', hn', hs', rule_complement, rotated_step (t+1) i j]


/-- The finite-state boundary result, including all cells outside its finite square. -/
lemma rotated_sampled (n : ℕ) (i j : ℤ) :
    rotated (2^n-1) i j = true ↔
      0 ≤ i ∧ i ≤ (2^n-1:ℕ) ∧ 0 ≤ j ∧ j ≤ (2^n-1:ℕ) ∧
      (i=0 ∨ i=(2^n-1:ℕ) ∨ j=0 ∨ j=(2^n-1:ℕ)) := by
  by_cases hi : 0 ≤ i
  · by_cases hj : 0 ≤ j
    · by_cases hit : i ≤ (2^n-1:ℕ)
      · by_cases hjt : j ≤ (2^n-1:ℕ)
        · lift i to ℕ using hi
          lift j to ℕ using hj
          rw [rotated_nat, A273539Automaton.sampled n i j (by have := Nat.two_pow_pos n; omega)
            (by have := Nat.two_pow_pos n; omega)]
          omega
        · rw [rotated_support _ _ _ (Or.inr (by omega))]
          simp only [Bool.false_eq_true, false_iff]
          omega
      · rw [rotated_support _ _ _ (Or.inl (by omega))]
        simp only [Bool.false_eq_true, false_iff]
        omega
    · rw [rotated_neg _ _ _ (Or.inr (by omega))]
      simp only [Bool.false_eq_true, false_iff]
      omega
  · rw [rotated_neg _ _ _ (Or.inl (by omega))]
    simp only [Bool.false_eq_true, false_iff]
    omega

/-- At each positive sampled time, the OFF cells form exactly one diamond boundary. -/
theorem diamond (n : ℕ) (hn : 0<n) (x y : ℤ) :
    state 779 (2^n-1) x y = false ↔ |x|+|y|=(2^n-1:ℕ) := by
  let t := 2^n-1
  have ht : 1 ≤ t := by
    have : 2 ≤ 2^n := Nat.le_pow hn
    omega
  by_cases hp : (x+y+(t:ℤ))%2=0
  · let i := (x+y+(t:ℤ))/2
    let j := (x-y+(t:ℤ))/2
    have hx : i+j-t=x := by dsimp [i,j]; omega
    have hy : i-j=y := by dsimp [i,j]; omega
    have h := bridge t ht i j
    rw [hx,hy] at h
    rw [h, Bool.not_eq_false']
    change rotated (2^n-1) i j = true ↔ _
    rw [rotated_sampled]
    change 0 ≤ i ∧ i ≤ (t:ℤ) ∧ 0 ≤ j ∧ j ≤ (t:ℤ) ∧
      (i=0 ∨ i=(t:ℤ) ∨ j=0 ∨ j=(t:ℤ)) ↔ |x|+|y|=(t:ℤ)
    rcases le_total 0 x with hxp | hxn <;> rcases le_total 0 y with hyp | hyn
    · rw [abs_of_nonneg hxp, abs_of_nonneg hyp]; omega
    · rw [abs_of_nonneg hxp, abs_of_nonpos hyn]; omega
    · rw [abs_of_nonpos hxn, abs_of_nonneg hyp]; omega
    · rw [abs_of_nonpos hxn, abs_of_nonpos hyn]; omega
  · have hon := A273539Consequences.parity_on 779 (by simp) t ht x y (by omega)
    change state 779 t x y = false ↔ _
    rw [hon]
    simp only [Bool.true_eq_false, false_iff]
    change |x|+|y|≠(t:ℤ)
    rcases le_total 0 x with hxp | hxn <;> rcases le_total 0 y with hyp | hyn
    · rw [abs_of_nonneg hxp, abs_of_nonneg hyp]; omega
    · rw [abs_of_nonneg hxp, abs_of_nonpos hyn]; omega
    · rw [abs_of_nonpos hxn, abs_of_nonneg hyp]; omega
    · rw [abs_of_nonpos hxn, abs_of_nonpos hyn]; omega

end A273539Bridge

/-! ## Counting the diamond and completing the source conjectures -/

namespace A273539Count
open OMA.S_oeis_a273539 A273539Consequences

private lemma row_positions (t x y : ℕ) (hx : x ≤ 2*t) (hy : y ≤ 2*t) :
    |(x:ℤ)-t|+|(y:ℤ)-t|=(t:ℤ) ↔ y=Nat.dist x t ∨ y=2*t-Nat.dist x t := by
  unfold Nat.dist
  rcases le_total (x:ℤ) t with hxp | hxn <;> rcases le_total (y:ℤ) t with hyp | hyn
  · rw [abs_of_nonpos (by omega), abs_of_nonpos (by omega)]; omega
  · rw [abs_of_nonpos (by omega), abs_of_nonneg (by omega)]; omega
  · rw [abs_of_nonneg (by omega), abs_of_nonpos (by omega)]; omega
  · rw [abs_of_nonneg (by omega), abs_of_nonneg (by omega)]; omega

private lemma sum_pair (L d e : ℕ) (hd : d<L) (he : e<L) :
    (∑ y ∈ Finset.range L, if y=d ∨ y=e then 1 else 0) = if d=e then 1 else 2 := by
  have hf : (Finset.range L).filter (fun y => y=d ∨ y=e) = {d,e} := by
    ext y
    simp only [Finset.mem_filter, Finset.mem_range, Finset.mem_insert,
      Finset.mem_singleton]
    omega
  rw [Finset.sum_boole, hf]
  by_cases h : d=e
  · simp [h]
  · simp [h]

/-- Count a diamond by rows, with one cell at each end and two in every other row. -/
theorem off_count : SampledOffCount := by
  intro n hn
  let t := 2^n-1
  have ht : 0<t := by have := (Nat.le_pow hn : 2 ≤ 2^n); omega
  have hrow (x : ℕ) (hx : x ∈ Finset.range (2*t+1)) :
      (∑ y ∈ Finset.range (2*t+1), bit (!(state 779 t ((x:ℤ)-t) ((y:ℤ)-t)))) +
        (if x=0 ∨ x=2*t then 1 else 0) = 2 := by
    have hx' : x ≤ 2*t := by have := Finset.mem_range.mp hx; omega
    have hd : Nat.dist x t ≤ t := by unfold Nat.dist; omega
    have hxy : (∑ y ∈ Finset.range (2*t+1), bit (!(state 779 t ((x:ℤ)-t) ((y:ℤ)-t)))) =
        ∑ y ∈ Finset.range (2*t+1), if y=Nat.dist x t ∨ y=2*t-Nat.dist x t then 1 else 0 := by
      apply Finset.sum_congr rfl
      intro y hy
      have hy' : y ≤ 2*t := by have := Finset.mem_range.mp hy; omega
      have h := (A273539Bridge.diamond n hn ((x:ℤ)-t) ((y:ℤ)-t)).trans
        (row_positions t x y hx' hy')
      change state 779 t ((x:ℤ)-t) ((y:ℤ)-t) = false ↔ _ at h
      cases hb : state 779 t ((x:ℤ)-t) ((y:ℤ)-t) <;> simp_all [bit]
    rw [hxy, sum_pair (2*t+1) (Nat.dist x t) (2*t-Nat.dist x t) (by omega) (by omega)]
    have he : Nat.dist x t=2*t-Nat.dist x t ↔ x=0 ∨ x=2*t := by
      unfold Nat.dist
      omega
    by_cases h : x=0 ∨ x=2*t <;> simp [he, h]
  have hsum := Finset.sum_congr rfl hrow
  rw [Finset.sum_add_distrib, sum_pair (2*t+1) 0 (2*t) (by omega) (by omega)] at hsum
  have hne : ¬ (0=2*t) := by omega
  simp only [hne, ↓reduceIte, Finset.sum_const, Finset.card_range, smul_eq_mul] at hsum
  change offCount t=4*t
  unfold offCount
  omega

end A273539Count

theorem OMA.solution : type_of% @OMA.S_oeis_a273539.main :=
  A273539Consequences.off_count_suffices A273539Count.off_count
