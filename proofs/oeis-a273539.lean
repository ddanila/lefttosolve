private def cert (k : Fin 451) : Certificate := certificates k.val
private def certNext (k : Fin 451) (b : Fin 8) : Fin 451 :=
  ⟨certificateTransitions (8*k.val+b.val) % 451, by omega⟩

private def terminalCheck (k : ℕ) : Bool :=
  let p := cert ⟨k%451, by omega⟩
  if p.initial then p.a.run 0 0 0 == (p.b.run 0 0 0 && p.c.run 0 0 0)
  else p.a.run 0 0 0 == rule (p.b.run 0 0 0) (p.c.run 0 0 0) (p.d.run 0 0 0) (p.e.run 0 0 0)

