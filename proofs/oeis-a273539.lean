def output (s : State) : Bool := outputs s.val
def next (s : State) (b : Fin 8) : State := ⟨transitions (8*s.val+b.val) % 90, by omega⟩
def digit (t i j : ℕ) : Fin 8 := ⟨4*(t%2)+2*(i%2)+j%2, by omega⟩

private def evaluate : ℕ → State → ℕ → ℕ → ℕ → Bool
  | 0, s, _, _, _ => output s
  | fuel+1, s, t, i, j =>
    if t+i+j=0 then output s
    else evaluate fuel (next s (digit t i j)) (t/2) (i/2) (j/2)

def value (s : State) (t i j : ℕ) : Bool := evaluate (t+i+j+1) s t i j

private lemma enough_fuel (s : State) (t i j f g : ℕ)
    (hf : t+i+j < f) (hg : t+i+j < g) : evaluate f s t i j = evaluate g s t i j := by
  cases f with
  | zero => omega
  | succ f =>
    cases g with
    | zero => omega
    | succ g =>
      simp only [evaluate]
      split
      · rfl
      · exact enough_fuel _ _ _ _ f g (by omega) (by omega)
termination_by t+i+j

set_option maxRecDepth 10000 in
private theorem zero_stable (s : State) : output (next s 0) = output s := by
  revert s
  decide

lemma value_zero (s : State) : value s 0 0 0 = output s := rfl

lemma value_step (s : State) (t i j : ℕ) :
    value s t i j = value (next s (digit t i j)) (t/2) (i/2) (j/2) := by
  by_cases h : t+i+j=0
  · have ht : t=0 := by omega
    have hi : i=0 := by omega
    have hj : j=0 := by omega
    subst t; subst i; subst j
    simp only [value_zero, digit]
    exact (zero_stable s).symm
  · unfold value
    rw [evaluate]
    simp only [h, ↓reduceIte]
    exact enough_fuel _ _ _ _ _ _ (by omega) (by omega)

lemma value_unfold (s : State) (t i j : ℕ) :
    value s t i j = if t+i+j=0 then output s
      else value (next s (digit t i j)) (t/2) (i/2) (j/2) := by
  split
  · have ht : t=0 := by omega
    have hi : i=0 := by omega
    have hj : j=0 := by omega
    subst t; subst i; subst j
    rfl
  · exact value_step s t i j

structure Term where
  s : State
  useT : Bool
  useI : Bool
  useJ : Bool
  dt : ℕ
  di : ℕ
  dj : ℕ
  deriving DecidableEq, Inhabited

def Term.run (p : Term) (t i j : ℕ) : Bool :=
  value p.s ((if p.useT then t else 0)+p.dt)
    ((if p.useI then i else 0)+p.di) ((if p.useJ then j else 0)+p.dj)

def Term.advance (p : Term) (bt bi bj : ℕ) : Term :=
  let ct := (if p.useT then bt else 0)+p.dt
  let ai := (if p.useI then bi else 0)+p.di
  let aj := (if p.useJ then bj else 0)+p.dj
  ⟨next p.s (digit ct ai aj), p.useT, p.useI, p.useJ, ct/2, ai/2, aj/2⟩

set_option maxRecDepth 10000 in
lemma term_step (p : Term) (t i j bt bi bj : ℕ) :
    p.run (2*t+bt) (2*i+bi) (2*j+bj) = (p.advance bt bi bj).run t i j := by
  simp only [Term.run, Term.advance]
  rw [value_step]
  congr 1
  · congr 1
    apply Fin.ext
    simp only [digit, Fin.val_mk]
    split <;> split <;> split <;> omega
  · by_cases h : p.useT = true <;> simp only [h, Bool.false_eq_true, ↓reduceIte] <;> omega
  · by_cases h : p.useI = true <;> simp only [h, Bool.false_eq_true, ↓reduceIte] <;> omega
  · by_cases h : p.useJ = true <;> simp only [h, Bool.false_eq_true, ↓reduceIte] <;> omega

/-- The rotated four-parent update is ON exactly for one or two ON parents. -/
def rule (a b c d : Bool) : Bool :=
  decide (a.toNat+b.toNat+c.toNat+d.toNat=1 ∨ a.toNat+b.toNat+c.toNat+d.toNat=2)

structure Certificate where
  initial : Bool
  a : Term
  b : Term
  c : Term
  d : Term
  e : Term
  deriving DecidableEq, Inhabited

def Certificate.holds (p : Certificate) (t i j : ℕ) : Prop :=
  if p.initial then p.a.run t i j = (p.b.run t i j && p.c.run t i j)
  else p.a.run t i j = rule (p.b.run t i j) (p.c.run t i j) (p.d.run t i j) (p.e.run t i j)

def Certificate.advance (p : Certificate) (bt bi bj : ℕ) : Certificate :=
  ⟨p.initial, p.a.advance bt bi bj, p.b.advance bt bi bj, p.c.advance bt bi bj,
    p.d.advance bt bi bj, p.e.advance bt bi bj⟩

set_option maxRecDepth 10000 in
lemma certificate_step (p : Certificate) (t i j bt bi bj : ℕ) :
    p.holds (2*t+bt) (2*i+bi) (2*j+bj) ↔ (p.advance bt bi bj).holds t i j := by
  simp only [Certificate.holds, Certificate.advance, term_step]
  rfl

