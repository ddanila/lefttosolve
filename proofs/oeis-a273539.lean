private lemma false_next (b : Fin 8) : next 87 b = 87 := by
  revert b
  decide

private lemma value_false (t i j : ℕ) : value 87 t i j = false := by
  rw [value_unfold]
  split
  · rfl
  · rw [false_next]
    exact value_false (t/2) (i/2) (j/2)
termination_by t+i+j

private lemma detector_next (axis : Bool) (b : Fin 8) :
    next (if axis then 89 else 88) b =
      if (if axis then b.val%2 else (b.val/2)%2)=0 then (if axis then 89 else 88) else 87 := by
  cases axis <;> revert b <;> decide

private lemma value_detector (axis : Bool) (t i j : ℕ) :
    value (if axis then 89 else 88) t i j = decide ((if axis then j else i)=0) := by
  by_cases h : t+i+j=0
  · have ht : t=0 := by omega
    have hi : i=0 := by omega
    have hj : j=0 := by omega
    subst t; subst i; subst j
    cases axis <;> rfl
  · rw [value_unfold]
    simp only [h, ↓reduceIte]
    rw [detector_next]
    have hi : ((digit t i j).val/2)%2=i%2 := by simp only [digit, Fin.val_mk]; omega
    have hj : (digit t i j).val%2=j%2 := by simp only [digit, Fin.val_mk]; omega
    rw [hi,hj]
    by_cases hz : (if axis then j else i)%2=0
    · have hh : (if axis then j%2 else i%2)=0 := by cases axis <;> simpa using hz
      rw [if_pos hh, value_detector axis (t/2) (i/2) (j/2)]
      congr 1
      cases axis <;> simp_all <;> omega
    · have hh : (if axis then j%2 else i%2)≠0 := by cases axis <;> simpa using hz
      rw [if_neg hh, value_false]
      cases axis <;> simp_all <;> omega
termination_by t+i+j

