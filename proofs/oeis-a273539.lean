/-- The automaton has the single-seed initial state, not an assumed closed formula. -/
theorem initial (i j : ℕ) : value 0 0 i j = decide (i=0 ∧ j=0) := by
  have h := certificate_valid 4 0 i j
  change value 0 0 i j = (value 88 0 i j && value 89 0 i j) at h
  rw [show value 88 0 i j = decide (i=0) from value_detector false 0 i j,
    show value 89 0 i j = decide (j=0) from value_detector true 0 i j] at h
  simpa only [Bool.decide_and] using h


structure Boundary where
  s : State
  zi : Bool
  oi : Bool
  zj : Bool
  oj : Bool
  deriving DecidableEq, Inhabited

private def boundaries : Array Boundary := #[
⟨0,true,true,true,true⟩,
⟨5,true,false,true,false⟩,
⟨6,true,false,false,true⟩,
⟨7,false,true,true,false⟩,
⟨8,false,true,false,true⟩,
⟨27,true,false,false,false⟩,
⟨28,false,false,true,false⟩,
⟨11,false,false,false,false⟩,
⟨32,false,false,false,true⟩,
⟨36,false,true,false,false⟩]
private def boundaryNexts : Array ℕ := #[1,2,3,4,1,5,6,7,5,2,7,8,6,7,3,9,7,8,9,4,5,5,7,7,6,7,6,7,7,7,7,7,7,8,7,8,7,7,9,9]

private def boundary (k : Fin 10) : Boundary := boundaries[k.val]!
private def boundaryNext (k : Fin 10) (bi bj : Fin 2) : Fin 10 :=
  ⟨boundaryNexts[4*k.val+2*bi.val+bj.val]! % 10, by omega⟩
private def Boundary.advance (p : Boundary) (bi bj : Fin 2) : Boundary :=
  ⟨next p.s ⟨4+2*bi.val+bj.val, by omega⟩,
   p.zi && decide (bi.val=0), p.oi && decide (bi.val=1),
   p.zj && decide (bj.val=0), p.oj && decide (bj.val=1)⟩
private def Boundary.holds (p : Boundary) (n i j : ℕ) : Prop :=
  (p.zi=true ∧ i=0) ∨ (p.oi=true ∧ i=2^n-1) ∨
  (p.zj=true ∧ j=0) ∨ (p.oj=true ∧ j=2^n-1)

set_option maxRecDepth 10000 in
private lemma boundary_closed (k : Fin 10) (bi bj : Fin 2) :
    (boundary k).advance bi bj = boundary (boundaryNext k bi bj) := by
  revert k bi bj
  decide +kernel

set_option maxRecDepth 10000 in
private lemma boundary_terminal (k : Fin 10) :
    output (boundary k).s = true ↔ (boundary k).holds 0 0 0 := by
  revert k
  unfold Boundary.holds
  decide +kernel

private lemma boundary_valid (n : ℕ) (k : Fin 10) (i j : ℕ)
    (hi : i < 2^n) (hj : j < 2^n) :
    value (boundary k).s (2^n-1) i j = true ↔ (boundary k).holds n i j := by
  induction n generalizing k i j with
  | zero =>
    have hi0 : i=0 := by simpa using hi
    have hj0 : j=0 := by simpa using hj
    subst i; subst j
    exact boundary_terminal k
  | succ n ih =>
    have hp : 0 < 2^n := Nat.two_pow_pos n
    have hpow : 2^(n+1) = 2 * 2^n := by rw [pow_succ]; omega
    have ht0 : (2^(n+1)-1)%2=1 := by omega
    have ht1 : (2^(n+1)-1)/2=2^n-1 := by omega
    let bi : Fin 2 := ⟨i%2, by omega⟩
    let bj : Fin 2 := ⟨j%2, by omega⟩
    have hh := ih (boundaryNext k bi bj) (i/2) (j/2) (by omega) (by omega)
    rw [← boundary_closed] at hh
    rw [value_step]
    have hd : digit (2^(n+1)-1) i j = ⟨4+2*bi.val+bj.val, by omega⟩ := by
      apply Fin.ext
      simp only [digit, ht0, bi, bj, Fin.val_mk]
    rw [ht1, hd]
    change value ((boundary k).advance bi bj).s (2^n-1) (i/2) (j/2) = true ↔ _
    rw [hh]
    simp only [Boundary.holds, Boundary.advance, Bool.and_eq_true, decide_eq_true_eq,
      bi, bj]
    have hi0 : i%2=0 ∧ i/2=0 ↔ i=0 := by omega
    have hj0 : j%2=0 ∧ j/2=0 ↔ j=0 := by omega
    have hi1 : i%2=1 ∧ i/2=2^n-1 ↔ i=2^(n+1)-1 := by omega
    have hj1 : j%2=1 ∧ j/2=2^n-1 ↔ j=2^(n+1)-1 := by omega
    simp only [and_assoc, hi0, hj0, hi1, hj1]

/-- At the sampled times, the rotated ON cells are exactly the square boundary. -/
theorem sampled (n i j : ℕ) (hi : i < 2^n) (hj : j < 2^n) :
    value 0 (2^n-1) i j = true ↔ i=0 ∨ i=2^n-1 ∨ j=0 ∨ j=2^n-1 := by
  have h := boundary_valid n 0 i j hi hj
  change value 0 (2^n-1) i j = true ↔
    (true=true ∧ i=0) ∨ (true=true ∧ i=2^n-1) ∨
    (true=true ∧ j=0) ∨ (true=true ∧ j=2^n-1) at h
  simpa only [true_and, eq_self] using h

