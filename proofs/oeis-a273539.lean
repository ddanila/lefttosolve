private theorem certificate_valid (k : Fin 451) (t i j : ℕ) : (cert k).holds t i j := by
  by_cases h : t+i+j=0
  · have ht : t=0 := by omega
    have hi : i=0 := by omega
    have hj : j=0 := by omega
    subst t; subst i; subst j
    exact certificate_terminal k
  · have ih := certificate_valid (certNext k (digit t i j)) (t/2) (i/2) (j/2)
    rw [← certificate_closed] at ih
    have ht : (digit t i j).val/4 = t%2 := by simp only [digit, Fin.val_mk]; omega
    have hi : ((digit t i j).val/2)%2 = i%2 := by simp only [digit, Fin.val_mk]; omega
    have hj : (digit t i j).val%2 = j%2 := by simp only [digit, Fin.val_mk]; omega
    rw [ht,hi,hj] at ih
    have hv := (certificate_step (cert k) (t/2) (i/2) (j/2) (t%2) (i%2) (j%2)).mpr ih
    simpa only [show 2*(t/2)+t%2=t by omega, show 2*(i/2)+i%2=i by omega,
      show 2*(j/2)+j%2=j by omega] using hv
termination_by t+i+j

