def cell (n t x : ℤ) : Prop := core
  (fun k => decide (x ≤ k))
  (fun k => decide (2*t-n ≤ k))
  (fun k => decide (x-t ≤ k))
  (fun k => decide (x+t-n ≤ k))
  (fun k => decide (4*x-2*t-n ≤ k))
  (fun k => decide (4*x-2*t+3*n ≤ k))
  (fun k => decide (2*t-3*n ≤ k))
  (fun k => decide (2*x-n ≤ k))
  (fun k => decide (n%8 ≤ k))
  (fun k => decide ((t+x-n)%3 ≤ k))
  (fun k => decide ((4*t-x)%12 ≤ k))
  (fun k => decide ((4*t-x+n)%12 ≤ k))
  (fun k => decide ((4*t-x+2*n)%12 ≤ k))
  (fun k => decide ((4*t-x+3*n)%12 ≤ k))
  (fun k => decide (t%4 ≤ k))
  (fun k => decide (x%4 ≤ k))
  (fun k => decide ((t+x-n/2)%3 ≤ k))
  (fun k => decide ((t+x+n/2)%3 ≤ k))
  (fun k => decide ((4*t-x-n/2)%12 ≤ k))

def reduced (N T X r s v : ℤ) : Prop := core
  (fun k => decide (X ≤ (k-v)/12))
  (fun k => decide (T-N ≤ (k-2*s+r)/24))
  (fun k => decide (X-T ≤ (k-v+s)/12))
  (fun k => decide (X+T-2*N ≤ (k-v-s+r)/12))
  (fun k => decide (2*X-T-N ≤ (k-4*v+2*s+r)/24))
  (fun k => decide (2*X-T+3*N ≤ (k-4*v+2*s-3*r)/24))
  (fun k => decide (T-3*N ≤ (k-2*s+3*r)/24))
  (fun k => decide (X-N ≤ (k-2*v+r)/24))
  (fun k => decide (r%8 ≤ k))
  (fun k => decide ((s+v-r)%3 ≤ k))
  (fun k => decide ((4*s-v)%12 ≤ k))
  (fun k => decide ((4*s-v+r)%12 ≤ k))
  (fun k => decide ((4*s-v+2*r)%12 ≤ k))
  (fun k => decide ((4*s-v+3*r)%12 ≤ k))
  (fun k => decide (s%4 ≤ k))
  (fun k => decide (v%4 ≤ k))
  (fun k => decide ((s+v-r/2)%3 ≤ k))
  (fun k => decide ((s+v+r/2)%3 ≤ k))
  (fun k => decide ((4*s-v-r/2)%12 ≤ k))

lemma reduce (N T X r s v : ℤ) :
    cell (24*N+r) (12*T+s) (12*X+v) ↔ reduced N T X r s v := by
  apply Iff.of_eq
  unfold cell reduced
  congr 1
  all_goals funext k; simp only [decide_eq_decide]; omega

end A334502Model
